# Kopiera till .env och fyll i. .env är gitignorerad och läses bara av mathem-cart.
# Behövs bara om du aktiverar Mathem-integrationen (/setup mathem).

# Ditt eget Mathem-konto.
MATHEM_EMAIL=
MATHEM_PASSWORD=

# Din egen kontaktadress (e-post eller URL). Den skickas i User-Agent så att Mathem kan
# nå den som kör verktyget. Använd din egen, inte projektets.
MATHEM_BOT_CONTACT=
